# Frontend Environment Variables Example
# Copy this file to .env and configure with your values

# Blog API URL
# Set this to use the live API (MongoDB on Render)
# If not set, the blog will use static data from src/data/blogPosts.json
# For development with local API: http://localhost:3002
# For production: https://your-api.onrender.com
VITE_API_BASE_URL=

# Note: .env is in .gitignore for security
# Never commit .env with real API URLs or secrets
