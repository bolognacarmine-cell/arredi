# Frontend Environment Variables Example
# Copy this file to .env and configure with your values

# API Configuration
# Leave empty for same-origin (recommended for production)
# For development with local API: http://localhost:3002
# For production with separate API: https://your-api.onrender.com
VITE_API_BASE_URL=

# Cloudinary Configuration (for client-side image uploads)
# Get these from your Cloudinary dashboard
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# Note: .env is in .gitignore for security
# Never commit .env with real API URLs or secrets
