# MongoDB Connection (REQUIRED)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/arredi?retryWrites=true&w=majority

# Server Configuration
PORT=3002
NODE_ENV=development

# CORS Configuration
FRONTEND_ORIGIN=http://localhost:8443

# Cloudinary (optional for server-side operations)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Admin User Configuration (for seed script)
ADMIN_EMAIL=admin@farcom.local
ADMIN_PASSWORD=your_secure_admin_password_here
ADMIN_NAME=Admin Farcom

# Admin Reset Password (optional - defaults to Farcom2026 if not set)
# This is the password that will be set when using the reset code "buongiorno"
ADMIN_RESET_PASSWORD=Farcom2026

# Session Secret for express-session (REQUIRED)
SESSION_SECRET=your_secure_random_session_secret_here

# Per deploy su Render, configura queste variabili nelle Environment Variables:
# - MONGODB_URI: La tua stringa di connessione MongoDB Atlas
# - SESSION_SECRET: Una stringa casuale sicura per le sessioni
# - ADMIN_EMAIL: Email admin per accesso pannello
# - ADMIN_PASSWORD: Password admin per accesso pannello
# - NODE_ENV: production
